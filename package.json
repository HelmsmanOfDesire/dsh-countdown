{
  "name": "@sxh20154102013/workday-lantern",
  "version": "1.0.0",
  "description": "下班倒计时插件：在 DSH 任意页面显示沙漏倒计时，四段工作时段可自由配置，沙量按真实时间比例减少。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "countdown",
    "hourglass",
    "workday",
    "productivity"
  ],
  "license": "MIT",
  "author": "sxh20154102013",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxh20154102013/dsh-workday-lantern.git"
  },
  "homepage": "https://github.com/sxh20154102013/dsh-workday-lantern#readme",
  "bugs": {
    "url": "https://github.com/sxh20154102013/dsh-workday-lantern/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
